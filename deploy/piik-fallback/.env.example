# IMPORTANT: rename this file to .env on the VPS and use your own domain/password.
# Add media.study26.site (A record) and relay.study26.site (DNS-only A record)
# to the VPS public IPv4. This example does NOT create those DNS records.
PIIK_DOMAIN=media.study26.site
PUBLIC_BASE_URL=https://media.study26.site
ALLOWED_ORIGINS=https://media.study26.site
PORT=8787
PIIK_ENV=production

# Require the teacher to enter the site passphrase to create a Piik room.
# Viewer invitations bypass this gate; do NOT disclose the invite publicly.
SITE_ACCESS_PASSWORD=REPLACE_WITH_UNIQUE_LONG_RANDOM_SECRET
ROOM_EMPTY_TIMEOUT_SECONDS=3600
MAX_VIEWERS_PER_ROOM=20
ENDPOINT_MEDIA_COPY_CAPACITY=2

# Must be a DNS-only address directly pointing at your VPS (UDP).
STUN_URLS=stun:relay.study26.site:3478
STUN_LISTEN_HOST=0.0.0.0
NAT_PREDICTION_ENABLED=false

# Embedded SFU allows fallback on compatible UDP networks (NOT TURN/TCP).
SFU_UDP_PORT=7882
SFU_LISTEN_HOST=0.0.0.0
SFU_ONLY=false
# If behind NAT, configure the public IPv4 explicitly:
SFU_PUBLIC_IP=
